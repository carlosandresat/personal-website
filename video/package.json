{
  "name": "personal-website-video",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "studio": "remotion studio",
    "render": "pnpm render:landscape && pnpm render:portrait",
    "render:landscape": "remotion render PythonTrailerLandscape out/python-trailer-16x9.mp4",
    "render:portrait": "remotion render PythonTrailerPortrait out/python-trailer-9x16.mp4",
    "typecheck": "tsc --noEmit",
    "render:web": "node scripts/render-web.mjs",
    "upload": "node scripts/upload.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.524",
    "@remotion/google-fonts": "4.0.524",
    "@remotion/transitions": "4.0.524",
    "@vercel/blob": "2.8.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remotion": "4.0.524"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "typescript": "^6.0.3"
  }
}
